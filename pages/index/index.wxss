.container {
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.page-header {
  padding: 10rpx 8rpx 28rpx;
}

.page-eyebrow {
  display: block;
  font-size: 22rpx;
  color: #8e8e93;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
}

.page-header-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 56rpx;
  line-height: 1.08;
  color: #111111;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.page-subtitle {
  font-size: 25rpx;
  color: #6e6e73;
  line-height: 1.55;
}

.record-card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(17, 17, 17, 0.045);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.045);
}

.card-header {
  margin-bottom: 28rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  color: #111111;
  font-weight: 700;
}

.card-caption {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #8e8e93;
}

.type-section {
  margin-bottom: 36rpx;
}

.type-label {
  font-size: 24rpx;
  color: #6e6e73;
  margin-bottom: 18rpx;
  display: block;
  letter-spacing: 1rpx;
}

.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.type-item {
  padding: 14rpx 24rpx;
  background: #f7f7fa;
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #3a3a3c;
  transition: all 0.2s ease;
}

.type-item:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.type-item.active {
  background: rgba(46, 163, 106, 0.1);
  border-color: rgba(46, 163, 106, 0.16);
  color: #2ea36a;
  font-weight: 600;
}

.amount-section {
  margin-bottom: 32rpx;
}

.amount-label {
  font-size: 24rpx;
  color: #6e6e73;
  margin-bottom: 18rpx;
  display: block;
  letter-spacing: 1rpx;
}

.amount-input-wrapper {
  display: flex;
  align-items: center;
  background: #fbfbfd;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 28rpx;
  padding: 0 28rpx;
  min-height: 112rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.currency {
  font-size: 38rpx;
  color: #8e8e93;
  font-weight: 600;
  margin-right: 16rpx;
}

.amount-input {
  flex: 1;
  font-size: 52rpx;
  font-weight: 700;
  color: #111111;
  height: 112rpx;
}

.note-section {
  margin-bottom: 36rpx;
}

.note-input {
  width: 100%;
  height: 104rpx;
  background: #fbfbfd;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 24rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
  box-sizing: border-box;
  color: #111111;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.submit-btn {
  background: linear-gradient(180deg, #45bb7d 0%, #2ea36a 100%);
  color: #ffffff;
  border-radius: 28rpx;
  height: 104rpx;
  line-height: 104rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(46, 163, 106, 0.16);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.submit-btn:active {
  opacity: 0.92;
  transform: scale(0.98);
}

.summary-card {
  background: linear-gradient(145deg, #4dbd82 0%, #2ea36a 58%, #257d53 100%);
  border-radius: 36rpx;
  padding: 40rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 32rpx rgba(46, 163, 106, 0.16);
}

.summary-title {
  font-size: 23rpx;
  opacity: 0.78;
  margin-bottom: 12rpx;
}

.summary-amount {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.summary-row {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.summary-item {
  flex: 1;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  backdrop-filter: blur(12rpx);
}

.summary-item-label {
  font-size: 22rpx;
  opacity: 0.72;
}

.summary-item-value {
  font-size: 38rpx;
  font-weight: 700;
  margin-top: 12rpx;
}
