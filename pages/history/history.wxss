.container {
  padding: 24rpx;
  background: #f2f2f7;
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.page-header {
  padding: 10rpx 8rpx 28rpx;
}

.page-eyebrow {
  display: block;
  font-size: 22rpx;
  color: #8e8e93;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
}

.page-header-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 56rpx;
  line-height: 1.08;
  color: #111111;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.page-subtitle {
  font-size: 25rpx;
  color: #6e6e73;
  line-height: 1.55;
}

.filter-section {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 30rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(17, 17, 17, 0.045);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.045);
}

.filter-tabs {
  display: flex;
  padding: 14rpx;
  gap: 12rpx;
}

.filter-helper {
  padding: 0 30rpx 26rpx;
  font-size: 23rpx;
  color: #8e8e93;
}

.filter-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 18rpx;
  font-size: 28rpx;
  color: #3a3a3c;
  position: relative;
  background: #f7f7fa;
  border-radius: 22rpx;
  transition: all 0.2s ease;
  border: 1rpx solid transparent;
}

.filter-tab:active {
  transform: scale(0.98);
}

.filter-tab.active {
  color: #2ea36a;
  font-weight: 600;
  background: rgba(46, 163, 106, 0.08);
  border-color: rgba(46, 163, 106, 0.1);
}

.arrow {
  font-size: 20rpx;
  color: #8e8e93;
  transition: transform 0.2s ease;
}

.arrow.up {
  transform: rotate(180deg);
}

.dropdown-panel {
  max-height: 400rpx;
  background: #ffffff;
  border-top: 1rpx solid rgba(60, 60, 67, 0.1);
}

.dropdown-scroll {
  max-height: 400rpx;
}

.dropdown-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  font-size: 28rpx;
  color: #1c1c1e;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.08);
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item.active {
  color: #2ea36a;
  font-weight: 600;
  background: rgba(46, 163, 106, 0.08);
}

.check-mark {
  color: #2ea36a;
  font-size: 28rpx;
  font-weight: 600;
}

.overview {
  display: flex;
  background: linear-gradient(150deg, #4dbd82 0%, #2ea36a 68%, #257d53 100%);
  border-radius: 34rpx;
  padding: 30rpx 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(46, 163, 106, 0.14);
}

.overview-item {
  flex: 1;
  text-align: center;
  padding: 10rpx 14rpx;
  position: relative;
}

.overview-item + .overview-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 1rpx;
  background: rgba(255, 255, 255, 0.18);
}

.overview-item .label {
  display: block;
  color: rgba(255, 255, 255, 0.74);
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.overview-item .amount {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.section {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 30rpx;
  padding: 34rpx 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(17, 17, 17, 0.045);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.045);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111111;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-meta {
  font-size: 23rpx;
  color: #8e8e93;
}

/* 分类统计 */
.category-stats {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.category-stat {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.category-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.category-name {
  font-size: 28rpx;
  color: #666;
}

.category-amount {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.category-percent {
  font-size: 28rpx;
  color: #2ea36a;
  font-weight: bold;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s;
}

/* 饼图样式 */
.pie-chart-container {
  display: flex;
  justify-content: center;
  padding: 28rpx 0 20rpx;
}

.pie-chart {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(17, 17, 17, 0.04);
}

.pie-hole {
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.05);
}

.pie-total {
  font-size: 44rpx;
  font-weight: 700;
  color: #111111;
}

.pie-label {
  font-size: 24rpx;
  color: #8e8e93;
  margin-top: 8rpx;
}

.legend-list {
  margin-top: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.06);
}

.legend-item:last-child {
  border-bottom: none;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  box-shadow: 0 0 0 5rpx rgba(46, 163, 106, 0.05);
}

.legend-name {
  flex: 1;
  font-size: 27rpx;
  color: #1c1c1e;
}

.legend-percent,
.legend-amount {
  margin-left: 16rpx;
}

.legend-percent {
  font-size: 24rpx;
  color: #8e8e93;
}

.legend-amount {
  min-width: 120rpx;
  font-size: 27rpx;
  color: #1c1c1e;
  font-weight: 700;
  text-align: right;
}

.empty {
  padding: 52rpx 20rpx;
  text-align: center;
  color: #8e8e93;
  font-size: 26rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.06);
}

.record-item:last-child {
  border-bottom: none;
}

.record-left,
.record-right {
  display: flex;
  flex-direction: column;
}

.record-right {
  align-items: flex-end;
}

.record-type {
  font-size: 28rpx;
  color: #1c1c1e;
  font-weight: 600;
}

.record-note,
.record-time {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8e8e93;
}

.record-amount {
  font-size: 28rpx;
  color: #2ea36a;
  font-weight: 700;
}
