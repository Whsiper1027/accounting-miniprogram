.container {
  padding: 30rpx;
  background: #f8f9fa;
  min-height: 100vh;
}

/* 头部提示 */
.header-tips {
  text-align: center;
  padding: 20rpx 0 30rpx;
}

.header-tips text {
  font-size: 26rpx;
  color: #999;
}

/* 分类网格 - 4列布局 */
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 图标圆圈 - 微信绿纯色 */
.icon-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #07c160;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s;
}

.icon-circle:active {
  transform: scale(0.95);
}

/* 图标文字 - 显示完整分类名 */
.icon-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  max-width: 100rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 添加按钮样式 */
.add-circle {
  background: #e8f5e9 !important;
}

.add-circle .icon-text {
  color: #07c160;
  font-size: 56rpx;
  font-weight: 300;
}

/* 底部面板遮罩 */
.panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

/* 底部面板内容 */
.panel-content {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.panel-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

/* 分区标签 */
.section-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
}

/* 输入区 */
.input-section {
  margin-bottom: 40rpx;
}

.name-input {
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  font-size: 32rpx;
  width: 100%;
  box-sizing: border-box;
  height: 90rpx;
}

/* 按钮区 */
.panel-buttons {
  display: flex;
  gap: 20rpx;
}

.btn-cancel,
.btn-confirm,
.btn-delete {
  flex: 1;
  font-size: 30rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  border: none;
  height: 90rpx;
  line-height: 34rpx;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background: #07c160;
  color: #fff;
}

.btn-delete {
  background: #ff6b6b;
  color: #fff;
  flex: 0.8;
}
