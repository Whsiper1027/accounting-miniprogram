.container {
  padding: 24rpx;
  background: #f2f2f7;
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.page-header {
  padding: 10rpx 8rpx 26rpx;
}

.page-eyebrow {
  display: block;
  font-size: 22rpx;
  color: #8e8e93;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
}

.page-header-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 56rpx;
  line-height: 1.08;
  color: #111111;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.page-subtitle {
  font-size: 25rpx;
  color: #6e6e73;
  line-height: 1.55;
}

.header-tips {
  text-align: center;
  padding: 8rpx 24rpx 28rpx;
}

.header-tips text {
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.6;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon-circle {
  width: 148rpx;
  height: 148rpx;
  border-radius: 38rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f6f7fb 100%);
  border: 1rpx solid rgba(17, 17, 17, 0.05);
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.icon-circle:active {
  transform: scale(0.96);
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.08);
}

.icon-text {
  font-size: 28rpx;
  color: #1c1c1e;
  font-weight: 600;
  max-width: 108rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.add-circle {
  background: linear-gradient(180deg, #ebf7f0 0%, #dceddf 100%) !important;
  border-color: rgba(46, 163, 106, 0.08);
}

.add-circle .icon-text {
  color: #2ea36a;
  font-size: 60rpx;
  font-weight: 300;
  line-height: 1;
}

.panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 17, 17, 0.28);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.panel-content {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 36rpx 36rpx 0 0;
  padding: 40rpx 28rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 40rpx rgba(15, 23, 42, 0.12);
}

.panel-grabber {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(60, 60, 67, 0.22);
  margin: 0 auto 26rpx;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.panel-heading {
  flex: 1;
  padding-right: 20rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111111;
}

.panel-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.55;
}

.panel-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f2f2f7;
  font-size: 32rpx;
  color: #8e8e93;
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-label {
  font-size: 24rpx;
  color: #6e6e73;
  margin-bottom: 16rpx;
  display: block;
}

.input-section {
  margin-bottom: 40rpx;
}

.name-input {
  background: #f5f5f7;
  border: 1rpx solid rgba(60, 60, 67, 0.12);
  border-radius: 24rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;
}

.panel-buttons {
  display: flex;
  gap: 16rpx;
}

.btn-cancel,
.btn-confirm,
.btn-delete {
  flex: 1;
  font-size: 30rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  border: none;
  height: 96rpx;
  line-height: 48rpx;
  font-weight: 600;
}

.btn-cancel {
  background: #f2f2f7;
  color: #3a3a3c;
}

.btn-confirm {
  background: linear-gradient(180deg, #45bb7d 0%, #2ea36a 100%);
  color: #fff;
  box-shadow: 0 16rpx 34rpx rgba(46, 163, 106, 0.18);
}

.btn-delete {
  background: #ff3b30;
  color: #fff;
  flex: 0.8;
}
